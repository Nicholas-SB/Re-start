<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the downloader needs the internet; this gets merged into the app's manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keep downloading when you leave the app: a foreground service of type "data sync",
         which has to show a notification (the download progress). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ asks before an app may show notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
